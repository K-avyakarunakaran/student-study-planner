 * Reminders Page - Student Study Planner
 * Manage exams and assignments reminders
 */

session_start();
require_once 'config/database.php';

if (!isset($_SESSION['user_id'])) {
    header("Location: login.php");
    exit();
}

$user_id = $_SESSION['user_id'];
$page_title = "Reminders";
$error = '';
$success = '';

// Handle add exam
if ($_SERVER['REQUEST_METHOD'] == 'POST' && isset($_POST['action'])) {
    if ($_POST['action'] == 'add_exam') {
        $exam_name = trim($_POST['exam_name'] ?? '');
        $subject_id = $_POST['subject_id'] ?? 0;
        $exam_date = $_POST['exam_date'] ?? '';
        $description = trim($_POST['description'] ?? '');

        if (empty($exam_name) || $subject_id == 0 || empty($exam_date)) {
            $error = "Exam name, subject and date are required!";
        } else {
            $stmt = $conn->prepare("INSERT INTO exams (user_id, exam_name, subject_id, exam_date, description) VALUES (?, ?, ?, ?, ?)");
            $stmt->bind_param("isis", $user_id, $exam_name, $subject_id, $exam_date, $description);

            if ($stmt->execute()) {
                $success = "Exam reminder added successfully!";
            } else {
                $error = "Failed to add exam reminder!";
            }
            $stmt->close();
        }
    }

    if ($_POST['action'] == 'add_assignment') {
        $assignment_name = trim($_POST['assignment_name'] ?? '');
        $subject_id = $_POST['subject_id'] ?? 0;
        $due_date = $_POST['due_date'] ?? '';
        $description = trim($_POST['description'] ?? '');

        if (empty($assignment_name) || $subject_id == 0 || empty($due_date)) {
            $error = "Assignment name, subject and due date are required!";
        } else {
            $stmt = $conn->prepare("INSERT INTO assignments (user_id, assignment_name, subject_id, due_date, description) VALUES (?, ?, ?, ?, ?)");
            $stmt->bind_param("isis", $user_id, $assignment_name, $subject_id, $due_date, $description);

            if ($stmt->execute()) {
                $success = "Assignment reminder added successfully!";
            } else {
                $error = "Failed to add assignment reminder!";
            }
            $stmt->close();
        }
    }
}

// Get subjects
$stmt = $conn->prepare("SELECT id, subject_name FROM subjects WHERE user_id = ? ORDER BY subject_name");
$stmt->bind_param("i", $user_id);
$stmt->execute();
$subjects = $stmt->get_result();
$stmt->close();

// Get exam reminders
$stmt = $conn->prepare("SELECT e.id, e.exam_name, s.subject_name, e.exam_date, e.description FROM exams e LEFT JOIN subjects s ON e.subject_id = s.id WHERE e.user_id = ? ORDER BY e.exam_date ASC LIMIT 10");
$stmt->bind_param("i", $user_id);
$stmt->execute();
$exams = $stmt->get_result();
$stmt->close();

// Get assignment reminders
$stmt = $conn->prepare("SELECT a.id, a.assignment_name, s.subject_name, a.due_date, a.description FROM assignments a LEFT JOIN subjects s ON a.subject_id = s.id WHERE a.user_id = ? ORDER BY a.due_date ASC LIMIT 10");
$stmt->bind_param("i", $user_id);
$stmt->execute();
$assignments = $stmt->get_result();
$stmt->close();

