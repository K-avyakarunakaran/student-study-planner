<?php
/**
 * Goals Page - Student Study Planner
 * Allows students to set daily, weekly and monthly goals
 */

session_start();
require_once 'config/database.php';

if (!isset($_SESSION['user_id'])) {
    header("Location: login.php");
    exit();
}

$user_id = $_SESSION['user_id'];
$page_title = "Goals";
$error = '';
$success = '';

// Handle add goal
if ($_SERVER['REQUEST_METHOD'] == 'POST' && isset($_POST['action']) && $_POST['action'] == 'add_goal') {
    $goal_title = trim($_POST['goal_title'] ?? '');
    $goal_type = $_POST['goal_type'] ?? 'Daily';
    $target_hours = $_POST['target_hours'] ?? 1;
    $target_date = $_POST['target_date'] ?? date('Y-m-d');

    if (empty($goal_title)) {
        $error = "Goal title is required!";
    } else {
        $stmt = $conn->prepare("INSERT INTO goals (user_id, goal_title, goal_type, target_hours, target_date, status) VALUES (?, ?, ?, ?, ?, 'Active')");
        $stmt->bind_param("issi", $user_id, $goal_title, $goal_type, $target_hours, $target_date);

        if ($stmt->execute()) {
            $success = "Goal created successfully!";
        } else {
            $error = "Failed to create goal!";
        }
        $stmt->close();
    }
}

// Get goals
$stmt = $conn->prepare("SELECT * FROM goals WHERE user_id = ? ORDER BY target_date ASC");
$stmt->bind_param("i", $user_id);
$stmt->execute();
$goals = $stmt->get_result();
$stmt->close();

require_once 'includes/header.php';
require_once 'includes/sidebar.php';
?>

